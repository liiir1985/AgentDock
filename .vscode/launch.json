{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AgentDock Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "--enable-proposed-api=agentdock.agentdock",
        "${workspaceFolder}/packages/vscode/test/fixtures/workspace"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
